# Local credentials, signing material, and machine-specific state.
.env
.env.*
credentials.json
*.pem
*.p12
*.mobileprovision
*.xcuserstate
xcuserdata/

# AOCI agent host integration (machine-bound; do not commit)
.codex/config.toml
.codex/config.toml.backup.*
